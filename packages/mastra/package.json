{
  "name": "@groundbox/mastra",
  "version": "0.1.0",
  "description": "Groundbox sandbox provider for Mastra workspaces: Firecracker microVM Linux sandboxes for agents.",
  "keywords": [
    "mastra",
    "workspace",
    "sandbox",
    "groundbox",
    "agents",
    "microvm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Ground-box/groundbox-integrations/tree/main/packages/mastra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ground-box/groundbox-integrations.git",
    "directory": "packages/mastra"
  },
  "bugs": {
    "url": "https://github.com/Ground-box/groundbox-integrations/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@groundbox/sdk": "^0.4.2"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.80.0-0 <2.0.0-0"
  },
  "devDependencies": {
    "@mastra/core": "1.85.0",
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
